@model QDPhone.Web.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Thanh toán";
}
<h2 class="mb-3">Thanh toán</h2>

@{
    var appliedCode = ViewBag.AppliedCouponCode as string;
    var appliedDiscount = ViewBag.AppliedCouponDiscount as string;
    var appliedFinalTotal = ViewBag.AppliedFinalTotal as string;
    var appliedCouponMessage = ViewBag.AppliedCouponMessage as string;
}

@if (!string.IsNullOrWhiteSpace(appliedCouponMessage))
{
    <div class="alert alert-success">@appliedCouponMessage</div>
}

@if (!string.IsNullOrWhiteSpace(appliedCode) && !string.IsNullOrWhiteSpace(appliedDiscount) && !string.IsNullOrWhiteSpace(appliedFinalTotal))
{
    <div class="alert alert-warning d-flex flex-wrap gap-3 justify-content-between">
        <span>Mã: <strong>@appliedCode</strong></span>
        <span>Giảm: <strong>-@appliedDiscount đ</strong></span>
        <span>Tổng sau giảm: <strong class="text-danger">@appliedFinalTotal đ</strong></span>
    </div>
}

<form method="post" class="card p-4" id="checkoutForm" novalidate>
    <div class="mb-3">
        <label class="form-label">Địa chỉ giao hàng <span class="text-danger">*</span></label>
        <input name="shippingAddress"
               id="shippingAddress"
               class="form-control @(TempData["AddressError"] != null ? "is-invalid" : "")"
               value="@ViewBag.ShippingAddress"
               placeholder="Nhập địa chỉ giao hàng..." />
        <div class="invalid-feedback" id="addressError">
            @(TempData["AddressError"] ?? "Vui lòng nhập địa chỉ giao hàng.")
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
        <input name="phoneNumber"
               id="phoneNumber"
               class="form-control @(TempData["PhoneError"] != null ? "is-invalid" : "")"
               value="@ViewBag.PhoneNumber"
               placeholder="Nhập số điện thoại..." />
        <div class="invalid-feedback" id="phoneError">
            @(TempData["PhoneError"] ?? "Vui lòng nhập số điện thoại hợp lệ (9–11 chữ số).")
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Tạm tính giỏ hàng</label>
        <input class="form-control" value="@Model.SubTotal.ToString("N0") đ" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Mã khuyến mãi</label>
        <div class="input-group">
            <input class="form-control" name="couponCode" value="@appliedCode" placeholder="Nhập mã ví dụ: WELCOME10" />
            <button type="submit" class="btn btn-outline-primary" formaction="/Checkout/ApplyCoupon">
                Áp dụng
            </button>

        </div>
        <small class="text-muted">Mã sẽ được kiểm tra trước khi thanh toán.</small>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" formaction="/Checkout/PlaceCod" class="btn btn-danger w-50">
            Thanh toán COD
        </button>

        <button type="submit" formaction="/Checkout/CreatePayOs" class="btn btn-primary w-50">
            Thanh toán PayOS
        </button>
    </div>

</form>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("checkoutForm");
            const addressInput = document.getElementById("shippingAddress");
            const phoneInput = document.getElementById("phoneNumber");
            const addressError = document.getElementById("addressError");
            const phoneError = document.getElementById("phoneError");

            function validateAddress() {
                const val = addressInput.value.trim();
                if (!val) {
                    addressInput.classList.add("is-invalid");
                    addressError.textContent = "Vui lòng nhập địa chỉ giao hàng.";
                    return false;
                }
                addressInput.classList.remove("is-invalid");
                addressInput.classList.add("is-valid");
                return true;
            }

            function validatePhone() {
                const val = phoneInput.value.trim();
                if (!val) {
                    phoneInput.classList.add("is-invalid");
                    phoneError.textContent = "Vui lòng nhập số điện thoại.";
                    return false;
                }
                if (!/^[0-9]{9,11}$/.test(val)) {
                    phoneInput.classList.add("is-invalid");
                    phoneError.textContent = "Số điện thoại chỉ gồm chữ số, độ dài 9–11 ký tự.";
                    return false;
                }
                phoneInput.classList.remove("is-invalid");
                phoneInput.classList.add("is-valid");
                return true;
            }

            addressInput.addEventListener("blur", validateAddress);
            phoneInput.addEventListener("blur", validatePhone);

            addressInput.addEventListener("input", function () {
                addressInput.classList.remove("is-invalid", "is-valid");
            });
            phoneInput.addEventListener("input", function () {
                phoneInput.classList.remove("is-invalid", "is-valid");
            });

            form.addEventListener("submit", function (e) {
                const okAddress = validateAddress();
                const okPhone = validatePhone();
                if (!okAddress || !okPhone) {
                    e.preventDefault();
                    if (!okAddress) addressInput.focus();
                    else phoneInput.focus();
                }
            });
        })();
    </script>
}